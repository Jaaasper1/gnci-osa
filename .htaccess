Options -Indexes

# Never serve config / SQL / dev files
<FilesMatch "\.(sql|md|txt|lock|json|example\.php|local\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# PWA: correct MIME type for the web app manifest
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>
