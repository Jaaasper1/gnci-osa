# Prevent PHP execution inside uploads folder
# Works on both Apache 2.2 (mod_access) and 2.4 (mod_authz_core / mod_access_compat)
<FilesMatch "\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Belt-and-suspenders: even if PHP execution isn't blocked above, don't let
# the PHP engine treat anything in this folder as a script.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
