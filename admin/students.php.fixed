<?php
// Start session FIRST before any includes
if (session_status() === PHP_SESSION_NONE) session_start();

require_once '../includes/db.php';
require_once '../includes/auth.php';
require_once '../includes/functions.php';

// AJAX handler — check BEFORE requireAdmin() so session redirect doesn't break fetch()
if (isset($_POST['ajax_action'])) {
    // Clear any accidental output, send JSON only
    if (ob_get_level()) ob_end_clean();
    header('Content-Type: application/json; charset=utf-8');

    // Still verify the user is actually an admin via session
    if (!isset($_SESSION['user_type']) || $_SESSION['user_type'] !== 'admin') {
        echo json_encode(['success' => false, 'message' => 'Unauthorized. Please log in again.']);
        exit;
    }

    $action = trim($_POST['ajax_action'] ?? '');
    $id     = (int)($_POST['id'] ?? 0);

    if ($id <= 0) {
        echo json_encode(['success' => false, 'message' => 'Invalid student ID.']);
        exit;
    }

    if ($action === 'approve') {
        $stmt = $pdo->prepare("UPDATE students SET is_active=1 WHERE id=? AND is_active=0");
        $stmt->execute([$id]);
        if ($stmt->rowCount() > 0) {
            // Return student data so JS can add the row immediately without refresh
            $student = $pdo->prepare("SELECT * FROM students WHERE id=?");
            $student->execute([$id]);
            $s = $student->fetch();
            echo json_encode([
                'success'    => true,
                'message'    => 'Student account approved!',
                'student'    => [
                    'id'         => $s['id'],
                    'student_id' => $s['student_id'],
                    'first_name' => $s['first_name'],
                    'last_name'  => $s['last_name'],
                    'course'     => $s['course'] ?? '',
                    'is_active'  => 1,
                ]
            ]);
        } else {
            echo json_encode(['success' => false, 'message' => 'Student not found or already approved.']);
        }
    } elseif ($action === 'reject') {
        $stmt = $pdo->prepare("DELETE FROM students WHERE id=? AND is_active=0");
        $stmt->execute([$id]);
        if ($stmt->rowCount() > 0) {
            echo json_encode(['success' => true, 'message' => 'Pending registration removed.']);
        } else {
            echo json_encode(['success' => false, 'message' => 'Student not found or already processed.']);
        }
    } elseif ($action === 'edit') {
        $student_id = trim($_POST['student_id'] ?? '');
        $first_name = trim($_POST['first_name'] ?? '');
        $last_name  = trim($_POST['last_name']  ?? '');
        $course     = trim($_POST['course']     ?? '');
        $email      = trim($_POST['email']      ?? '');

        if (!$first_name || !$last_name || !$student_id) {
            echo json_encode(['success' => false, 'message' => 'First name, last name, and Student ID are required.']);
            exit;
        }

        // Check duplicate student_id (excluding current record)
        $dup = $pdo->prepare("SELECT id FROM students WHERE student_id=? AND id!=?");
        $dup->execute([$student_id, $id]);
        if ($dup->fetch()) {
            echo json_encode(['success' => false, 'message' => 'Student ID already exists for another student.']);
            exit;
        }

        $stmt = $pdo->prepare("UPDATE students SET student_id=?, first_name=?, last_name=?, course=?, email=? WHERE id=?");
        $stmt->execute([$student_id, $first_name, $last_name, $course, $email ?: null, $id]);

        echo json_encode([
            'success'    => true,
            'message'    => 'Student updated successfully!',
            'student'    => [
                'id'         => $id,
                'student_id' => $student_id,
                'first_name' => $first_name,
                'last_name'  => $last_name,
                'course'     => $course,
                'email'      => $email,
            ]
        ]);
    } elseif ($action === 'reset_password') {
        $new_pass = trim($_POST['new_password'] ?? '');
        if (strlen($new_pass) < 9) {
            echo json_encode(['success' => false, 'message' => 'Password must be at least 9 characters.']);
            exit;
        }
        $stmt = $pdo->prepare("UPDATE students SET password=?, must_change_password=1 WHERE id=?");
        $stmt->execute([password_hash($new_pass, PASSWORD_DEFAULT), $id]);
        echo json_encode(['success' => true, 'message' => 'Password reset successfully! Student will be asked to change it on next login.']);
    } else {
        echo json_encode(['success' => false, 'message' => 'Unknown action.']);
    }
    exit;
}

requireAdmin();

$success = $error = '';



if (isset($_GET['toggle'])) {
    $pdo->prepare("UPDATE students SET is_active=? WHERE id=?")->execute([(int)$_GET['val'], (int)$_GET['id']]);
    header('Location: students.php'); exit;
}

// Approve a pending self-registration
if (isset($_GET['approve'])) {
    $pdo->prepare("UPDATE students SET is_active=1 WHERE id=? AND is_active=0")->execute([(int)$_GET['approve']]);
    $success = 'Student account approved!';
}

// Reject (delete) a pending self-registration
if (isset($_GET['reject'])) {
    $pdo->prepare("DELETE FROM students WHERE id=? AND is_active=0")->execute([(int)$_GET['reject']]);
    $success = 'Pending registration removed.';
}

$pending  = $pdo->query("SELECT * FROM students WHERE is_active=0 ORDER BY created_at DESC")->fetchAll();

// Get the currently active election (if any) so we can show each student's voting status
$activeElection = getActiveElection($pdo);
$votedIds = [];
if ($activeElection) {
    $voteRows = $pdo->prepare("SELECT DISTINCT student_id FROM votes WHERE election_id = ?");
    $voteRows->execute([$activeElection['id']]);
    $votedIds = array_flip(array_column($voteRows->fetchAll(), 'student_id'));
}

$students = $pdo->query("SELECT * FROM students WHERE is_active=1 ORDER BY last_name, first_name")->fetchAll();
?>
